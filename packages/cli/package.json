{
  "name": "kormem",
  "version": "0.1.3",
  "description": "Local memory for AI agents: index, linked vault and recall agent. QMD-compatible commands, MCP server, Claude Code hooks.",
  "license": "MIT",
  "author": "Kushal Sinha",
  "homepage": "https://github.com/kushalsinha/kormem#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kushalsinha/kormem.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/kushalsinha/kormem/issues",
  "keywords": [
    "memory",
    "agents",
    "llm",
    "mcp",
    "claude-code",
    "rag",
    "obsidian",
    "qmd",
    "cli"
  ],
  "type": "module",
  "bin": {
    "kormem": "dist/kormem.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "tsc && node scripts/readme.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
